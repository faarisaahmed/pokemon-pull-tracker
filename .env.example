# Next.js sends anonymous usage data to Vercel unless this is set.
NEXT_TELEMETRY_DISABLED=1

# Optional. Routes eBay requests through a proxy/scraping service so PSA graded
# comps can be fetched from a server. `{url}` is replaced with the URL-encoded
# eBay search URL. Without this, eBay returns 403 from most hosts.
# PPT_SCRAPER_URL=https://api.scraperapi.com?api_key=YOUR_KEY&url={url}

# Optional. Overrides where the SQLite database lives.
# PPT_DB_PATH=./data/pokemon.db
